---
/** The one detail page: glass back pill, bold title, spec line, lede, hero,
    then the body at the hero's width. Posts, write-ups and the about page
    all render through it. */
import Layout from './Layout.astro';
import SpeedReader from '../components/SpeedReader.tsx';

export interface SpecRow {
  value: string;
  /** Dates and years keep the mono spec voice. */
  mono?: boolean;
  accent?: boolean;
}

interface Props {
  title: string;
  /** Page <title>; defaults to "<title> — Hudson Paine". */
  pageTitle?: string;
  description?: string;
  /** Social card; defaults to the hero. */
  image?: string;
  spec?: SpecRow[];
  /** One paragraph, or several. */
  lede?: string | string[];
  hero?: string;
  heroCaption?: string;
}

const { title, pageTitle, description, image, spec = [], lede, hero, heroCaption } = Astro.props;
---
<Layout title={pageTitle ?? `${title} — Hudson Paine`} description={description} image={image ?? hero}>
  <main class="post-page hp-page hp-grid hp-framed">
    <nav class="post-nav hp-wide">
      <a class="back hp-glass-pill" href="/">← back</a>
      <span class="post-nav-actions">
        <SpeedReader client:idle />
        <button id="fullscreen-btn" class="fullscreen-btn hp-glass-pill" type="button">full screen ⤢</button>
      </span>
    </nav>
    <header>
      {/* Hyphenated words stay whole ("X-Cover", not "X- / Cover"). */}
      <h1>{title.split(' ').map((w, i) => [i ? ' ' : '', w.includes('-') ? <span class="nobr">{w}</span> : w])}</h1>
      {spec.length > 0 && (
        <div class="post-spec">
          {spec.map((r) => (
            <div class:list={['spec-row', { 'post-spec-cell': r.mono, accent: r.accent }]}>{r.value}</div>
          ))}
        </div>
      )}
      {lede && [lede].flat().map((para) => <p class="lede">{para}</p>)}
    </header>
    {hero && (
      <figure class="post-fig hero-fig hp-wide">
        <img class="hero" src={hero} alt="" decoding="async" />
        <figcaption class="post-fig-caption">fig. 01 — {heroCaption ?? title}</figcaption>
      </figure>
    )}
    <article class="prose hp-flow"><slot /></article>
  </main>
</Layout>

<script>
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>('.prose img')
  );
  const fullscreenBtn = document.getElementById('fullscreen-btn');

  if (images.length) {
    const srcs = images.map((img) => img.src);

    const overlay = document.createElement('div');
    overlay.className = 'lightbox';
    overlay.innerHTML = `
      <img class="lightbox-img" alt="" />
      <button class="lightbox-prev" aria-label="previous">‹</button>
      <button class="lightbox-next" aria-label="next">›</button>
      <div class="lightbox-count"></div>
    `;
    document.body.appendChild(overlay);

    const img = overlay.querySelector('.lightbox-img') as HTMLImageElement;
    const count = overlay.querySelector('.lightbox-count') as HTMLDivElement;
    const prevBtn = overlay.querySelector('.lightbox-prev') as HTMLButtonElement;
    const nextBtn = overlay.querySelector('.lightbox-next') as HTMLButtonElement;

    let index = 0;
    let open = false;

    const show = (i: number) => {
      index = (i + srcs.length) % srcs.length;
      img.src = srcs[index];
      count.textContent = srcs.length > 1 ? `${index + 1} / ${srcs.length}` : '';
    };

    const openLightbox = (i: number) => {
      open = true;
      show(i);
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      open = false;
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    };

    images.forEach((el, i) => {
      el.style.cursor = 'pointer';
      el.addEventListener('click', () => openLightbox(i));
    });

    fullscreenBtn?.addEventListener('click', () => openLightbox(0));

    overlay.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); show(index - 1); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); show(index + 1); });
    img.addEventListener('click', (e) => e.stopPropagation());

    window.addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  } else {
    fullscreenBtn?.remove();
  }

  // Autoplaying <video> tags: browsers pause them once they scroll out of
  // view and never resume automatically, so drive play/pause off actual
  // visibility instead of relying on the autoplay attribute alone.
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.prose video'));
  if (videos.length) {
    const videoObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    }, { threshold: 0.25 });
    videos.forEach((v) => videoObserver.observe(v));
  }
</script>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(0, 0, 0, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
  }
  .lightbox.is-open { display: flex; }
  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 2px;
  }
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 28px;
    color: #fff;
    opacity: 0.7;
    background: none;
  }
  .lightbox-prev:hover,
  .lightbox-next:hover { opacity: 1; }
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  .lightbox-count {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }
</style>

<style>
  .post-page { color: var(--fg); }
  /* Chrome row spans the hero's width: back and the actions sit on its edges. */
  .post-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 26px;
  }
  .post-nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* Text runs the same width as the photos. */
  .post-page > header,
  .prose > :global(*) { grid-column: wide; }
  /* Phones tap a photo to open the lightbox; this corner belongs to ⌘K. */
  @media (max-width: 767px) {
    .fullscreen-btn { display: none; }
  }
  header { margin: var(--space-7) 0 var(--space-6); }
  h1 {
    font-size: 44px;
    line-height: 1.02;
    color: var(--fg);
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
    margin: 0;
  }
  .nobr { white-space: nowrap; }
  .post-spec {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 20px;
    margin: var(--space-4) 0 0;
  }
  .spec-row {
    color: var(--fg-dim);
    font-size: 14px;
  }
  .spec-row.post-spec-cell { font-size: 11px; }
  .spec-row.accent { color: var(--accent); }
  .lede {
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg);
    margin: var(--space-5) 0 0;
  }
  .lede + .lede { margin-top: 0.8em; }
  .hero-fig { margin: 0 0 var(--space-6); }
  .hero {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 1em;
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
    margin: 12px 0;
  }
  .prose :global(.post-fig img) {
    margin: 0;
  }
  .prose :global(.post-img-grid img) {
    height: 100%;
    margin: 0;
  }
  .prose :global(h2),
  .prose :global(h3) {
    color: var(--fg);
    margin: 1.6em 0 0.6em;
  }
</style>
