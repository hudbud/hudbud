---
import { MT_THEMES, SAFE_THEME_NAMES } from '../data/themes';
import DialKitRoot from '../components/DialKitRoot';
import CommandPalette from '../components/CommandPalette';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** e.g. 'noindex, nofollow' for pages that shouldn't be found. */
  robots?: string;
}

const {
  title = 'hudbud.net — Hudson Paine',
  description = "design bike fish climb — Hudson Paine's personal site. Product design case studies, life posts, and weird little web experiments.",
  image = '/posts/graph-zoomed-in.jpg',
  robots,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(image, Astro.site).toString();

// Compact name -> color map for the inline anti-flash script below.
const THEME_DATA = Object.fromEntries(
  MT_THEMES.map((t) => [t.name, { bg: t.bg, bgInner: t.bgInner, fg: t.fg, dim: t.dim, accent: t.accent }])
);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="hudbud thoughts" href="/thoughts.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=DM+Sans:wght@400;500;600&family=Outfit:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body data-font="apfel">
  <script is:inline define:vars={{ themeData: THEME_DATA, safeThemeNames: SAFE_THEME_NAMES }}>
    (function () {
      try {
        var DEFAULT_FONT = 'apfel';

        // Accessibility mode (toggled from the site chrome, or inherited from
        // the OS reduced-motion preference on first visit) limits themes to
        // contrast-checked ones and disables motion.
        var a11yStored = localStorage.getItem('hp-a11y');
        var a11y = a11yStored !== null
          ? a11yStored === '1'
          : window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (a11y) document.documentElement.classList.add('hp-a11y');

        // A homepage visitor who picked a non-default layout: hide the
        // prerendered one until Portfolio swaps theirs in (it drops the class).
        var savedLayout = localStorage.getItem('hp-layout');
        if (location.pathname === '/' && (savedLayout === 'list' || savedLayout === 'gallery')) document.documentElement.classList.add('hp-layout-pending');

        // Everyone starts monochrome, light or dark with the OS. A theme or
        // font the visitor picks (FABs, shuffle, the mark, ⌘K) is saved and
        // then holds on every page until they pick again.
        var dark = window.matchMedia('(prefers-color-scheme: dark)');
        var mono = function () { return dark.matches ? 'hudbud_dark' : 'hudbud_light'; };
        var chosen = function () {
          var t = localStorage.getItem('hp-theme');
          return t && themeData[t] && (!a11y || safeThemeNames.indexOf(t) !== -1) ? t : null;
        };
        var paint = function (theme) {
          var mt = themeData[theme];
          var root = document.documentElement;
          root.style.setProperty('--bg', mt.bg);
          root.style.setProperty('--bg-inner', mt.bgInner);
          root.style.setProperty('--fg', mt.fg);
          root.style.setProperty('--fg-dim', mt.dim);
          root.style.setProperty('--fg-faint', 'color-mix(in srgb, ' + mt.fg + ' 30%, ' + mt.bg + ')');
          root.style.setProperty('--rule', 'color-mix(in srgb, ' + mt.fg + ' 14%, ' + mt.bg + ')');
          root.style.setProperty('--tile', 'color-mix(in srgb, ' + mt.fg + ' 8%, ' + mt.bg + ')');
          if (theme === 'rainbow_trail') {
            root.style.removeProperty('--accent');
            document.body.classList.add('rainbow-trail');
          } else {
            root.style.setProperty('--accent', mt.accent);
            document.body.classList.remove('rainbow-trail');
          }
        };

        var theme = chosen() || mono();
        var font = localStorage.getItem('hp-font') || DEFAULT_FONT;
        paint(theme);
        document.body.dataset.font = font;
        window.__hpInitial = { theme: theme, font: font, a11y: a11y };

        // Until they pick a theme, follow the OS live (and tell the chrome).
        dark.addEventListener('change', function () {
          if (chosen()) return;
          paint(mono());
          window.dispatchEvent(new CustomEvent('hp:theme', { detail: mono() }));
        });
      } catch (e) {}
    })();
  </script>
  <slot />
  <div class="hp-grid hp-grid-overlay" aria-hidden="true">
    <i class="o-rail"></i><i class="o-measure"></i><i class="o-aside"></i>
  </div>
  <script is:inline>
    // Ctrl+G toggles the layout grid overlay (same chord as Figma).
    window.addEventListener('keydown', function (e) {
      if (!e.ctrlKey || e.metaKey || e.altKey || e.key.toLowerCase() !== 'g') return;
      e.preventDefault();
      document.documentElement.classList.toggle('hp-show-grid');
    });
  </script>
  <DialKitRoot client:load />
  <CommandPalette client:idle />
</body>
</html>
