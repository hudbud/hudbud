---
import { MT_THEMES, SAFE_THEME_NAMES } from '../data/themes';
import DialKitRoot from '../components/DialKitRoot';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'hudbud.net — Hudson Paine',
  description = "design bike fish climb — Hudson Paine's personal site. Product design case studies, life posts, and weird little web experiments.",
  image = '/posts/graph-zoomed-in.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(image, Astro.site).toString();

// Compact name -> color map for the inline anti-flash script below.
const THEME_DATA = Object.fromEntries(
  MT_THEMES.map((t) => [t.name, { bg: t.bg, bgInner: t.bgInner, fg: t.fg, dim: t.dim, accent: t.accent }])
);
const THEME_NAMES = MT_THEMES.map((t) => t.name);
// Fonts eligible for the random pick on refresh. OpenDyslexic ('dys') stays
// available in the font menu but is only ever an explicit choice.
const FONT_IDS = ['mono', 'serif', 'sans', 'apfel', 'outfit'];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="hudbud thoughts" href="/thoughts.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=DM+Sans:wght@400;500;600&family=Outfit:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body data-font="apfel">
  <script is:inline define:vars={{ themeData: THEME_DATA, themeNames: THEME_NAMES, safeThemeNames: SAFE_THEME_NAMES, fontIds: FONT_IDS }}>
    (function () {
      try {
        var DEFAULT_THEME = 'earthsong';
        var DEFAULT_FONT = 'apfel';

        var themeLocked = localStorage.getItem('hp-lock-theme');
        var theme = themeLocked
          ? (localStorage.getItem('hp-theme') || DEFAULT_THEME)
          : safeThemeNames[Math.floor(Math.random() * safeThemeNames.length)];

        var fontLocked = localStorage.getItem('hp-lock-font');
        var font = fontLocked
          ? (localStorage.getItem('hp-font') || DEFAULT_FONT)
          : fontIds[Math.floor(Math.random() * fontIds.length)];

        var mt = themeData[theme] || themeData[DEFAULT_THEME];
        var root = document.documentElement;
        root.style.setProperty('--bg', mt.bg);
        root.style.setProperty('--bg-inner', mt.bgInner);
        root.style.setProperty('--fg', mt.fg);
        root.style.setProperty('--fg-dim', mt.dim);
        root.style.setProperty('--fg-faint', 'color-mix(in srgb, ' + mt.fg + ' 30%, ' + mt.bg + ')');
        root.style.setProperty('--rule', 'color-mix(in srgb, ' + mt.fg + ' 14%, ' + mt.bg + ')');
        root.style.setProperty('--tile', 'color-mix(in srgb, ' + mt.fg + ' 8%, ' + mt.bg + ')');
        if (theme === 'rainbow_trail') {
          root.style.removeProperty('--accent');
          document.body.classList.add('rainbow-trail');
        } else {
          root.style.setProperty('--accent', mt.accent);
        }
        document.body.dataset.font = font;
        window.__hpInitial = { theme: theme, font: font };
      } catch (e) {}
    })();
  </script>
  <slot />
  <DialKitRoot client:load />
</body>
</html>
