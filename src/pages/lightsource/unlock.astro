---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---
<Layout title="LightSource — Hudson Paine" description="LightSource case study by Hudson Paine. Password protected." robots="noindex, nofollow">
  <main class="unlock hp-page hp-grid">
    <a class="back hp-rail" href="/">← back</a>
    <header>
      <h1>LightSource</h1>
      <p class="lede">
        Brand, design system and the core sourcing workflow, 2025 to 2026. It shows the product
        from the inside, so it's behind a password.
      </p>
    </header>
    <form method="post" action="/lightsource/unlock">
      <input type="hidden" name="next" value="/lightsource" />
      <label>
        <span class="label">password</span>
        <input type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <button type="submit">unlock</button>
      <p class="error" role="alert" hidden></p>
    </form>
    <p class="ask">Need it? <a class="hp-bio-link" href="mailto:hudbud@gmail.com?subject=LightSource%20case%20study">hudbud@gmail.com</a></p>
  </main>
</Layout>

<script is:inline>
  (function () {
    var q = new URLSearchParams(location.search);
    var next = q.get('next');
    if (next) document.querySelector('.unlock input[name="next"]').value = next;
    var msg = q.get('error') === 'wrong' && 'not quite. try again?';
    if (msg) {
      var el = document.querySelector('.unlock .error');
      el.textContent = msg;
      el.hidden = false;
    }
  })();
</script>

<style>
  .unlock { color: var(--fg); }
  .back {
    align-self: baseline;
    color: var(--fg-dim);
    font-size: 12px;
  }
  .back:hover { color: var(--accent); }
  header { align-self: baseline; }
  h1 {
    font-size: 44px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0;
  }
  .lede {
    font-size: 16px;
    line-height: 1.65;
    margin: var(--space-5) 0 0;
  }
  form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  label {
    display: grid;
    gap: var(--space-2);
    flex: 1 1 16rem;
  }
  .label {
    font-size: 12px;
    color: var(--fg-dim);
  }
  input[type='password'] {
    font: inherit;
    font-size: 15px;
    color: var(--fg);
    background: var(--tile);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 9px 12px;
    outline: none;
  }
  input[type='password']:focus { border-color: var(--accent); }
  button {
    padding: 9px 16px;
    border: 1px solid var(--fg-dim);
    border-radius: 999px;
    color: var(--fg);
  }
  button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .error {
    flex-basis: 100%;
    margin: 0;
    font-size: 13px;
    color: var(--accent);
  }
  .ask {
    margin: var(--space-6) 0 0;
    font-size: 13px;
    color: var(--fg-dim);
  }
</style>
