---
export const prerender = true;
import LightSourceShell from '../../components/LightSourceShell.astro';

export function getStaticPaths() {
  return [
    { params: { page: undefined }, props: { page: 'index', title: 'Redesigning LightSource' } },
    { params: { page: 'rebrand' }, props: { page: 'rebrand', title: 'The LightSource rebrand' } },
    { params: { page: 'system' }, props: { page: 'system', title: 'Design system and navigation' } },
    { params: { page: 'sourcing' }, props: { page: 'sourcing', title: 'Sourcing projects redesign' } },
  ] as const;
}

const { page, title } = Astro.props;
---
<LightSourceShell page={page} title={title} />
