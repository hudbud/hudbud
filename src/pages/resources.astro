---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

const entries = await getCollection('posts', (e) => e.data.tags.includes('resources') && !e.data.draft);
entries.sort((a, b) => +b.data.date - +a.data.date);

const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, ...(await render(e)) }))
);
---
<PostLayout
  title="Resources"
  description="Design and outdoor resource lists curated by Hudson Paine."
  spec={[{ value: `${entries.length} lists`, mono: true }]}
>
  {rendered.map(({ entry, Content }) => (
    <section>
      <h2><a href={`/posts/${entry.id}`}>{entry.data.title}</a></h2>
      <Content />
    </section>
  ))}
</PostLayout>

<style>
  section {
    margin: 0 0 var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }
  section h2 { margin-top: 0; }
  section h2 a {
    color: var(--fg);
    text-decoration: none;
  }
  section h2 a:hover { color: var(--accent); }
</style>
