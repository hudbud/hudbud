---
export const prerender = true;
import GifcitiesLayout from '../../layouts/GifcitiesLayout.astro';
---
<GifcitiesLayout
  title="GifCities for iMessage — search the internet's GIF attic"
  description="An iMessage app that lets you search and send animated GIFs from GifCities, the Internet Archive's archive of Geocities-era GIFs, without leaving iMessage."
>
  <section class="hero">
    <div class="app-icon" aria-hidden="true">GIF</div>
    <h1 class="rainbow">
      <span style="color:#ff3355">G</span><span style="color:#ff9933">i</span><span style="color:#ffee33">f</span><span style="color:#33ff66">C</span><span style="color:#33ccff">i</span><span style="color:#6633ff">t</span><span style="color:#ff33cc">i</span><span style="color:#ff3355">e</span><span style="color:#ff9933">s</span>
      for
      <span style="color:#33ccff">i</span><span style="color:#6633ff">M</span><span style="color:#ff33cc">e</span><span style="color:#ff3355">s</span><span style="color:#ff9933">s</span><span style="color:#ffee33">a</span><span style="color:#33ff66">g</span><span style="color:#33ccff">e</span>
    </h1>
    <p class="pitch">Search the internet's GIF attic, right from iMessage.</p>
    <p class="badge">[ COMING SOON ON THE 🍎 APP STORE ]</p>
    <p class="construction">
      <span class="blink">🚧</span> THIS SITE IS PERMANENTLY UNDER CONSTRUCTION <span class="blink">🚧</span>
    </p>
  </section>

  <hr class="gold" />

  <section class="demo">
    <h2>~ see it in action ~</h2>
    <div class="phone-frame">
      <div class="imessage-search-bar">🔍 search gifcities...</div>
      <div class="masonry-slot">[ screenshot coming soon ]</div>
    </div>
    <p class="demo-caption">
      Search bar and masonry GIF grid, right inside the iMessage compose UI &mdash;
      find a GIF and tap to drop it straight into your message.
    </p>
  </section>

  <hr class="gold" />

  <section class="features">
    <h2>~ what it does ~</h2>
    <ul class="feature-list">
      <li><strong>Search GifCities</strong> &mdash; look up anything in the Internet Archive's Geocities-era GIF collection.</li>
      <li><strong>Animated previews</strong> &mdash; see GIFs move before you send them, right in the results grid.</li>
      <li><strong>Tap to send</strong> &mdash; one tap drops the GIF straight into your message. No copy, no paste.</li>
      <li><strong>No account needed</strong> &mdash; no sign-up, no login, no profile. Open it and start searching.</li>
    </ul>
  </section>

  <hr class="gold" />

  <section class="attribution">
    <p class="fine-print">
      Powered by <a href="https://gifcities.org">GifCities</a>, a project by the Internet Archive.
      This app is an independent third-party client, not affiliated with or endorsed by the Internet Archive.
    </p>
  </section>
</GifcitiesLayout>

<style>
  .hero {
    text-align: center;
  }

  .app-icon {
    width: 70px;
    height: 70px;
    line-height: 70px;
    margin: 0 auto 10px;
    background: #000;
    border: 2px solid var(--gold);
    color: var(--green);
    font-family: "Times New Roman", Times, serif;
    font-weight: bold;
    font-size: 18px;
  }

  h1.rainbow {
    font-family: "Times New Roman", Times, serif;
    font-size: 28px;
    margin: 0 0 10px;
  }

  .pitch {
    font-size: 20px;
    text-align: center;
    color: #cccccc;
    margin: 0 0 14px;
  }

  .badge {
    text-align: center;
    font-family: "Times New Roman", Times, serif;
    font-weight: bold;
    color: #000;
    background: var(--gold);
    display: inline-block;
    padding: 8px 14px;
    margin: 0 auto 16px;
  }

  .construction {
    text-align: center;
    font-family: "Times New Roman", Times, serif;
    font-weight: bold;
    background: repeating-linear-gradient(45deg, #ffcc00 0 12px, #000 12px 24px);
    color: #fff;
    padding: 8px;
    max-width: 460px;
    margin: 0 auto;
  }

  h2 {
    color: var(--cyan);
  }

  .demo {
    text-align: center;
  }

  .phone-frame {
    width: 260px;
    margin: 0 auto;
    border: 2px solid #666;
    background: #111;
  }

  .imessage-search-bar {
    border-bottom: 1px solid #666;
    padding: 8px 10px;
    font-family: "Times New Roman", Times, serif;
    font-size: 14px;
    color: #ccc;
    text-align: left;
  }

  .masonry-slot {
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: "Times New Roman", Times, serif;
    font-size: 13px;
    color: #888;
    padding: 20px;
  }

  .demo-caption {
    max-width: 480px;
    margin: 14px auto 0;
    text-align: center;
    color: #cccccc;
  }

  .feature-list {
    max-width: 620px;
    margin: 0 auto;
    padding-left: 22px;
  }

  .feature-list li {
    margin-bottom: 10px;
  }

  .attribution {
    text-align: center;
  }

  .fine-print {
    color: #aaaaaa;
    font-size: 15px;
    max-width: 560px;
    margin: 0 auto;
  }
</style>
