---
export const prerender = true;
import PostLayout from '../layouts/PostLayout.astro';
import { RESUME, SELECT_CLIENTS } from '../data/resume';

interface Skill {
  title: string;
  lead: string;
  body: string;
}

const SKILLS: Skill[] = [
  {
    title: 'Product Design',
    lead: 'Zero to one, and one to whole.',
    body: "I've launched products from nothing and grown MVPs into cohesive, mature products. UI and iconography are the roots; the full arc is the work.",
  },
  {
    title: 'Creative & Art Direction',
    lead: 'Art, technology, innovation — same job.',
    body: 'I draw from a wide bench: 3D and animation, photography, machining, circuitry, motion, drawing and painting. It all feeds the work.',
  },
  {
    title: 'Design Systems',
    lead: 'Systems are how craft scales.',
    body: "I built Carvana's design system — tokens, components, docs, and the buy-in that makes a system stick.",
  },
  {
    title: 'Teams',
    lead: 'Strong ideas need someone to carry them.',
    body: 'I stand behind good designers and clear the way — through the product, and through the organization.',
  },
  {
    title: 'AI-Enabled Design',
    lead: 'New tools, same standards.',
    body: 'I build AI into design practice — the workflows worth adopting, and the judgment about where craft stays human.',
  },
  {
    title: 'Research',
    lead: 'Decisions come from real people.',
    body: 'Early discovery that shapes what gets built; usability work that sharpens what exists.',
  },
  {
    title: 'Visual Design',
    lead: 'At home in the pixels.',
    body: 'Type, grids, icons, motion. This is where I came up, and I never really left.',
  },
  {
    title: 'Branding & Spaces',
    lead: 'Brands are products too.',
    body: 'Lots of studio work — identities, sites, and spaces that live everywhere the product does.',
  },
];

interface Photo {
  src: string;
  alt: string;
  w: number;
  h: number;
}

const MEDIA = 'https://media.hudbud.net/images';

// Pairs sit side by side; flex-grow by aspect ratio keeps their heights
// equal at any width. Me, then me again.
const PAIRS: Photo[][] = [
  [
    { src: `${MEDIA}/about-flowers-solo.webp`, alt: 'Portrait in front of flowers', w: 1102, h: 1427 },
    { src: `${MEDIA}/hudson-1.webp`, alt: 'Office selfie', w: 1200, h: 900 },
  ],
  [
    { src: `${MEDIA}/about-sonic.webp`, alt: "Sonic the Hedgehog in Sans's blue hoodie, hands in pockets", w: 534, h: 534 },
    { src: `${MEDIA}/stanczyk-1.webp`, alt: 'Jan Matejko, Stańczyk (1862)', w: 2400, h: 1785 },
  ],
];
const PAIR_CAPTIONS = ['in person', 'self-portraits, roughly'];

// Three masonry columns. The short one stretches (cropping a touch) so the
// bottoms line up above the full-width closer. Phones flatten to two columns.
const PHOTO_COLUMNS: (Photo & { wide?: boolean })[][] = [
  [
    { src: `${MEDIA}/about-cosmo-ride.webp`, alt: 'Riding with Cosmo in the front basket', w: 1200, h: 1600 },
    { src: `${MEDIA}/about-climb-cliff.webp`, alt: 'Selfie on a sea cliff climb', w: 1200, h: 1600 },
    { src: `${MEDIA}/about-cosmo-beach.webp`, alt: 'Biking by Ocean Beach with Cosmo in the basket', w: 1200, h: 1600 },
  ],
  [
    { src: `${MEDIA}/about-fly-fishing.webp`, alt: 'Fly fishing a river', w: 1200, h: 1600 },
    { src: `${MEDIA}/about-climb-granite.webp`, alt: 'Belay ledge high on a granite wall', w: 1600, h: 1200, wide: true },
    { src: `${MEDIA}/about-cosmo-office.webp`, alt: 'Cosmo in the bike basket at the office', w: 1200, h: 1600 },
  ],
  [
    { src: `${MEDIA}/about-cosmo-tote.webp`, alt: 'Cosmo riding in a tote bag', w: 1200, h: 1600 },
    { src: `${MEDIA}/about-monster.webp`, alt: 'Selfie with a Monster', w: 1200, h: 1600 },
    { src: `${MEDIA}/about-cosmo-crater-lake.webp`, alt: 'Holding Cosmo at Crater Lake', w: 1200, h: 1600 },
  ],
];
const CLOSER: Photo = { src: `${MEDIA}/about-bench.webp`, alt: 'Black and white, together on a park bench', w: 1600, h: 1064 };

const pad = (n: number) => String(n).padStart(2, '0');
const photosFrom = PAIRS.length * 2 + 1;
const photosTo = photosFrom + PHOTO_COLUMNS.flat().length;

interface ArchiveEntry {
  year: string;
  paragraphs: string[];
}

// Past about-page copy, preserved verbatim-ish from old versions of the site.
const ARCHIVE: ArchiveEntry[] = [
  {
    year: '2023',
    paragraphs: [
      "With over 10 years of experience working across agencies and tech companies, I'm a wearer of many hats. Particularly product design, design systems & branding. My happy places are the intersection of engineering and design, or the intersection of sports, friends, and the outdoors.",
      "If I'm not working on my homelab, shooting/editing photos, or building brands & sites… I'm probably biking, fishing, or coastal foraging. Most realistically, I'm cooking, cleaning, exercising, or taking my dog on a bike ride.",
      'There are links to some live work below. For details and case studies of work not shown, please reach out.',
    ],
  },
  {
    year: '2021',
    paragraphs: [
      "✌️ Yo! ❤️ I'm Hudson, a designer based in San Francisco. 🌲 Specializing in Design Systems, Motion Graphics, and Branding. ⚡ Forging the connection between innovation and aesthetic.",
      "HOWDY! I'M HUDSON, A WEARER OF MANY HATS. 🤠 Not only do I have an ever-expanding collection of hats that I wear daily, but I also am known for my multidisciplinary skillset and agility in dynamic environments. I'm a designer and design-nature-engineering-lover based in San Francisco, CA. I'm a highly detail oriented person who loves systems and consistency, but also loves to draw outside the lines and break out of the box. My design career started in branding, but has evolved into product design, design systems, and motion graphics. Throughout my career, I have always worn multiple hats within digitally-focused companies. I'm an extremely curious person who excels in fast-paced, dynamic environments. I love the experience of creative exploration. Outside of work, you can catch me taking photos, making videos, making experimental motion graphics, painting, printing hats, and experimenting with new creative arts all the time. If I'm not working on a creative project, I'm probably DJing, rock climbing, building keyboards, cooking, collecting records, biking, or running.",
      'INSPIRED BY THE OUTDOORS — I LOVE A BEER WITH A VIEW. OR A VIEW WITH A BEER. OR JUST A VIEW. OR JUST A BEER.',
      'Originally from Portland, Oregon, I am a cooking and outdoors enthusiast. I draw most of my creative inspiration from nature itself, from forest bathing to ski touring to rock climbing, I love the sense of scale and perspective I get from the peaks and valleys of our planet.',
      "My journey to design was relatively roundabout. My creativity blossomed from shooting video. At a young age I started creating YouTube product reviews and sports videos with friends. This evolved into short films and onward to travel video. With film came a love for photography, which empowered me to try to communicate the beauty and wonder of our planet. Film and photo drove me to love title sequences, and I soon fell in love with typography. Typography quickly zoomed to all facets of graphic design, and in 2016, my career as a freelance designer began. After studying product design, animation, and manufacturing engineering at Cal Poly, San Luis Obispo, I began to freelance on many creative projects in product, marketing, and hardgoods. My skills ultimately converged into a career in product design, while still maintaining skills in animation and branding on the side.",
      "Don't Question, Just Do.",
      'Lost — /lɔst/ — 1. having gone astray or missed the way; bewildered as to place, direction, etc.',
      'Wonder — /ˈwʌndər/ — 1. to think or speculate curiously. 2. to be filled with admiration, amazement, or awe; marvel. 3. the emotion excited by what is strange and surprising.',
      'Experiment — /ɛkˈspɛrəˌmɛnt/ — 1. a test, trial, or tentative procedure; an act or operation for the purpose of discovering something unknown or of testing a principle, supposition, etc.',
    ],
  },
  {
    year: '2017',
    paragraphs: [
      "Born and raised in Portland, Oregon, I have been surrounded by great design and culture my whole life. It wasn't until I started attending Cal Poly that I learned to appreciate what I no longer had. Taking the inspiration from my home city and combining it with experiences of Central California drew me into a fervent passion for design and modern digital media.",
    ],
  },
];
---
<PostLayout
  title="Forging the connection between innovation & aesthetic"
  pageTitle="About — Hudson Paine"
  description="Product design expertise, creative direction, design systems, and leadership — about Hudson Paine's work."
  spec={[{ value: 'San Francisco' }, { value: 'product design, brand, design leadership, hella AI-enabled 😎🤓😎🤓😎🤓', accent: true }]}
  lede={[
    "Howdy! I'm Hudson. I'm an obsessive designer and outdoorsman. Happy to talk endlessly about product design, brand, the evolving meaning of design systems, motion, UX, user research, UI, cRaFt, you name it. Let's talk about the impact of infinitesimal details across broad deliverables. The devil is truly in the details. Or perhaps nirvana is in the details.",
    "Technobabble translation: i'm a spikey generalist who excels in leadership and design/creative direction.",
    'I also like to fly fish, build bikes, and rock climb. Anything to get me outside.',
    "I've spent my career in deep tech and highly technical teams, in agencies, and running my own studio. I've been obsessed with technology and design my whole life, and I truly do this for the love of the game. I love to make stuff. I love to obsess over details. I love delightful experiences. I love motion. I love FORM following FUNCTION. I love it all.",
    'I love design.',
  ]}
>
  {PAIRS.map((pair, i) => (
    <figure class="post-fig">
      <div class="pair">
        {pair.map((p) => (
          <img src={p.src} alt={p.alt} width={p.w} height={p.h} style={`flex-grow: ${p.w / p.h}`} decoding="async" />
        ))}
      </div>
      <figcaption class="post-fig-caption">fig. {pad(i * 2 + 1)}–{pad(i * 2 + 2)} — {PAIR_CAPTIONS[i]}</figcaption>
    </figure>
  ))}

  <h2>What I do</h2>
  <ol class="skills">
    {SKILLS.map((s) => (
      <li class="skill">
        <h3>{s.title}</h3>
        <p><span class="skill-lead">{s.lead}</span>{s.body}</p>
      </li>
    ))}
  </ol>

  <p class="forest">
    <span aria-hidden="true">🐟🌲🍄🐜🌿🪵 </span>Deep in the bark, the soil, the ants — then up above the canopy: the undulating hills,
    the valleys, the creeks and meadows. I work at both altitudes, and I don't lose the plot
    in between.<span aria-hidden="true"> 🏞️🌾🦋💧⛰️</span>
  </p>

  <figure class="post-fig">
    <div class="photos">
      {PHOTO_COLUMNS.map((col) => (
        <div class="photo-col">
          {col.map((p) => (
            <img class:list={{ wide: p.wide }} src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
          ))}
        </div>
      ))}
    </div>
    <img class="closer" src={CLOSER.src} alt={CLOSER.alt} width={CLOSER.w} height={CLOSER.h} loading="lazy" decoding="async" />
    <figcaption class="post-fig-caption">fig. {pad(photosFrom)}–{pad(photosTo)} — out and about, usually with Cosmo</figcaption>
  </figure>

  <h2>Experience</h2>
  <div class="resume">
    {RESUME.map((r) => (
      <div class="resume-row">
        <span class="years">{r.years}</span>
        <span class="role">{r.role}</span>
        <span class="org">{r.org}</span>
      </div>
    ))}
  </div>
  <p class="clients">
    <span class="label">select clients</span>
    {SELECT_CLIENTS.join(' · ')}
  </p>
  <p>
    Full work history on <a href="https://www.linkedin.com/in/hudsonpaine" target="_blank" rel="noopener">LinkedIn ↗</a>,
    or say hi at <a href="mailto:hudbud@gmail.com">hudbud@gmail.com</a>.
  </p>

  <details class="archive">
    <summary>about pages of years past</summary>
    {ARCHIVE.map((entry) => (
      <div class="archive-entry">
        <h3>{entry.year}</h3>
        {entry.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    ))}
  </details>
</PostLayout>

<style>
  /* Body type, headings and widths come from PostLayout; these are the
     page's own pieces: the photo pairs, the skills index, the photos, the
     resume table, the archive. */
  .pair {
    display: flex;
    gap: 8px;
  }
  .pair img {
    flex-basis: 0;
    min-width: 0;
    height: auto;
  }

  /* An index, not a card grid: title, then the copy, on hairlines like the
     resume below. */
  .skills {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .skill {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 0 16px;
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--rule);
  }
  .skill h3 {
    font-size: 15px;
    font-weight: 500;
    margin: 0;
  }
  .skill p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .skill-lead {
    display: block;
    color: var(--fg);
  }
  @media (max-width: 767px) {
    .skill { grid-template-columns: minmax(0, 1fr); }
    .skill p { margin-top: 6px; }
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .photo-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .photo-col img {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    object-fit: cover;
  }
  .closer {
    display: block;
    height: auto;
    margin-top: 8px !important;
  }
  @media (max-width: 767px) {
    .photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
    .photo-col { display: contents; }
    .photo-col img { aspect-ratio: 3 / 4; }
    .photo-col img.wide { grid-column: span 2; aspect-ratio: 3 / 2; }
  }

  .forest {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-style: italic;
  }

  .resume-row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 16px;
    padding: 10px 0;
    font-size: 14px;
    color: var(--fg-dim);
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
  }
  .resume-row .years { font-variant-numeric: tabular-nums; }
  .resume-row .role { color: var(--fg); font-size: 15px; }
  @media (max-width: 480px) {
    .resume-row { grid-template-columns: 90px 1fr; }
    .resume-row .org { grid-column: 2; }
  }
  .clients {
    margin-top: var(--space-5);
    color: var(--fg-dim);
  }
  .clients .label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    margin-bottom: 6px;
  }
  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dashed var(--fg-faint);
  }

  .archive {
    margin: var(--space-7) 0 0;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-5);
  }
  .archive summary {
    cursor: pointer;
    font-size: 14px;
    color: var(--fg-dim);
    user-select: none;
  }
  .archive summary:hover { color: var(--accent); }
  .archive-entry { margin: var(--space-5) 0 0; }
  .archive-entry h3 {
    font-size: 13px;
    color: var(--fg-faint);
    letter-spacing: 0.1em;
    margin: 0 0 10px;
  }
  .archive-entry p {
    font-size: 15px;
    color: var(--fg-dim);
  }
</style>
