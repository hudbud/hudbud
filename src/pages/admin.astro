---
// Post photos from a phone: add them to an existing post or start a new one.
// The browser shrinks each photo, the Worker (/api/admin, worker/index.js)
// stores it in R2 and commits the markdown to GitHub, and the push deploys.
// A phone that sleeps mid-upload picks up where it left off.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { loadAdminPosts } from '../lib/posts';

const posts = await loadAdminPosts();
const tags = ['life', 'thoughts', 'resources', 'work', 'projects'];
---
<Layout title="admin — hudbud.net" robots="noindex, nofollow">
  <main class="admin hp-page hp-grid">
    <a class="back hp-rail" href="/">← back</a>
    <h1>post from here</h1>

    <form class="lock" hidden>
      <label>
        <span class="label">password</span>
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button type="submit">unlock</button>
      <p class="msg" role="alert"></p>
    </form>

    <form class="compose" hidden>
      <div class="modes" role="radiogroup">
        <label><input type="radio" name="mode" value="add" checked /> <span>add to a post</span></label>
        <label><input type="radio" name="mode" value="new" /> <span>new post</span></label>
      </div>

      <label class="for-add">
        <span class="label">post</span>
        <select name="slug">
          {posts.map((p) => <option value={p.slug}>{p.title} · {p.year}{p.draft ? ' · draft' : ''}</option>)}
        </select>
      </label>

      <div class="for-new" hidden>
        <label>
          <span class="label">title</span>
          <input type="text" name="title" autocomplete="off" />
        </label>
        <div class="row">
          <label>
            <span class="label">tag</span>
            <select name="tag">{tags.map((t) => <option value={t}>{t}</option>)}</select>
          </label>
          <label>
            <span class="label">date</span>
            <input type="date" name="date" />
          </label>
        </div>
        <label class="check"><input type="checkbox" name="draft" /> <span>save as draft</span></label>
      </div>

      <label>
        <span class="label">words <em>optional</em></span>
        <textarea name="text" rows="3"></textarea>
      </label>

      <label class="pick">
        {/* Narrow on purpose: iOS converts RAW and HEIC to JPEG for anything not listed. */}
        <input type="file" accept="image/jpeg,image/png,image/webp" multiple />
        <span>choose photos</span>
      </label>
      <ul class="thumbs"></ul>

      <button type="submit" class="publish">publish</button>
      <button type="button" class="discard" hidden>start over</button>
      <p class="msg" role="status"></p>
    </form>
  </main>
</Layout>

<script is:inline define:vars={{ slugs: posts.map((p) => p.slug) }}>
  (function () {
    var lock = document.querySelector('.admin .lock');
    var compose = document.querySelector('.admin .compose');
    var thumbs = compose.querySelector('.thumbs');
    var picker = compose.querySelector('input[type=file]');
    var publishBtn = compose.querySelector('.publish');
    var discardBtn = compose.querySelector('.discard');
    var msg = compose.querySelector('.msg');
    var f = compose.elements;
    var files = [];

    f.date.value = new Date().toLocaleDateString('en-CA');

    function say(el, text) { el.textContent = text; }
    function slugify(t) { return t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80); }

    var authed = fetch('/api/admin/session').then(function (r) {
      (r.ok ? compose : lock).hidden = false;
      return r.ok;
    });

    lock.addEventListener('submit', function (e) {
      e.preventDefault();
      fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: lock.elements.password.value }),
      }).then(function (r) {
        if (!r.ok) return say(lock.querySelector('.msg'), 'not quite. try again?');
        lock.hidden = true;
        compose.hidden = false;
        run();
      });
    });

    function showMode() {
      var isNew = f.mode.value === 'new';
      compose.querySelector('.for-add').hidden = isNew;
      compose.querySelector('.for-new').hidden = !isNew;
    }
    compose.addEventListener('change', function (e) {
      if (e.target.name === 'mode') showMode();
    });

    function render() {
      thumbs.innerHTML = '';
      files.forEach(function (item, i) {
        var li = document.createElement('li');
        var img = document.createElement('img');
        img.src = item.preview;
        img.alt = '';
        img.onerror = async function () {
          img.onerror = null;
          var jpeg = embeddedJpeg(item.file, new Uint8Array(await item.file.arrayBuffer()));
          if (!jpeg) return;
          URL.revokeObjectURL(item.preview);
          img.src = item.preview = URL.createObjectURL(jpeg);
        };
        var x = document.createElement('button');
        x.type = 'button';
        x.textContent = '×';
        x.setAttribute('aria-label', 'remove photo');
        x.onclick = function () { URL.revokeObjectURL(item.preview); files.splice(i, 1); render(); };
        x.hidden = !!job;
        if (job) li.dataset.state = job.photos[i].url ? 'up' : '';
        li.append(img, x);
        thumbs.append(li);
      });
      say(picker.nextElementSibling, files.length ? 'add more photos' : 'choose photos');
    }

    picker.addEventListener('change', function () {
      Array.prototype.forEach.call(picker.files, function (file) {
        files.push({ file: file, preview: URL.createObjectURL(file) });
      });
      picker.value = '';
      render();
    });

    function toBlob(canvas, type, quality) {
      return new Promise(function (resolve) { canvas.toBlob(resolve, type, quality); });
    }

    // RAW+JPEG photos can arrive as the RAW file, which browsers can't
    // decode. Every RAW format embeds a JPEG preview (Olympus: 3200px), so
    // walk its markers to find the biggest one and use that instead.
    function jpegEnd(b, start) {
      var i = start + 2;
      while (i + 3 < b.length) {
        if (b[i] !== 0xff) return -1;
        var marker = b[i + 1];
        if (marker === 0xd9) return i + 2;
        i += 2 + ((b[i + 2] << 8) | b[i + 3]);
        if (marker !== 0xda) continue;
        // Scan data runs to the next marker; FF00 and restart markers are part of it.
        while (i + 1 < b.length && !(b[i] === 0xff && b[i + 1] !== 0 && (b[i + 1] < 0xd0 || b[i + 1] > 0xd7))) i++;
      }
      return -1;
    }

    function embeddedJpeg(file, b) {
      var best = null;
      for (var i = 0; i + 2 < b.length; i++) {
        if (b[i] !== 0xff || b[i + 1] !== 0xd8 || b[i + 2] !== 0xff) continue;
        var end = jpegEnd(b, i);
        if (end > 0 && (!best || end - i > best.end - best.start)) best = { start: i, end: end };
        if (end > 0) i = end - 1;
      }
      return best && file.slice(best.start, best.end, 'image/jpeg');
    }

    // The preview has no orientation of its own; it's in the RAW's TIFF header.
    function tiffOrientation(b) {
      if (!((b[0] === 0x49 && b[1] === 0x49) || (b[0] === 0x4d && b[1] === 0x4d))) return 1;
      var dv = new DataView(b.buffer);
      var le = b[0] === 0x49;
      var ifd = dv.getUint32(4, le);
      if (ifd + 2 > b.length) return 1;
      for (var k = 0, n = dv.getUint16(ifd, le); k < n; k++) {
        var e = ifd + 2 + k * 12;
        if (e + 10 <= b.length && dv.getUint16(e, le) === 0x0112) return dv.getUint16(e + 8, le);
      }
      return 1;
    }

    async function decode(file) {
      try {
        return { bmp: await createImageBitmap(file), orientation: 1 };
      } catch (err) {
        var b = new Uint8Array(await file.arrayBuffer());
        var jpeg = embeddedJpeg(file, b);
        if (!jpeg) throw new Error('couldn’t read ' + file.name);
        return { bmp: await createImageBitmap(jpeg), orientation: tiffOrientation(b) };
      }
    }

    // Same target as scripts/new-post.ts: 2400px wide, webp 82. Safari can't
    // encode webp, so it falls back to jpeg.
    async function shrink(file) {
      var d = await decode(file);
      var bmp = d.bmp;
      var turned = d.orientation === 6 || d.orientation === 8;
      var w = turned ? bmp.height : bmp.width;
      var h = turned ? bmp.width : bmp.height;
      var scale = Math.min(1, 2400 / w);
      var canvas = document.createElement('canvas');
      canvas.width = Math.round(w * scale);
      canvas.height = Math.round(h * scale);
      var ctx = canvas.getContext('2d');
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.rotate({ 3: Math.PI, 6: Math.PI / 2, 8: -Math.PI / 2 }[d.orientation] || 0);
      var dw = (turned ? canvas.height : canvas.width);
      var dh = (turned ? canvas.width : canvas.height);
      ctx.drawImage(bmp, -dw / 2, -dh / 2, dw, dh);
      bmp.close();
      var blob = await toBlob(canvas, 'image/webp', 0.82);
      if (!blob || blob.type !== 'image/webp') blob = await toBlob(canvas, 'image/jpeg', 0.85);
      canvas.width = canvas.height = 0;
      return blob;
    }

    // Uploads keep their place in IndexedDB: the shrunk photos, which ones made
    // it to R2, and the form. Names are fixed when the job starts, so a retry
    // overwrites rather than duplicates, and publish skips work it already did.
    var job = null;
    var running = false;
    var stalled = false;
    var inflight = null;
    var revived = false;
    var hiddenAt = 0;
    var wake = null;

    var db = new Promise(function (resolve, reject) {
      var req = indexedDB.open('hp-admin', 1);
      req.onupgradeneeded = function () { req.result.createObjectStore('kv'); };
      req.onsuccess = function () { resolve(req.result); };
      req.onerror = function () { reject(req.error); };
    });
    function store(mode, fn) {
      return db.then(function (d) {
        return new Promise(function (resolve, reject) {
          var tx = d.transaction('kv', mode);
          var req = fn(tx.objectStore('kv'));
          tx.oncomplete = function () { resolve(req && req.result); };
          tx.onerror = tx.onabort = function () { reject(tx.error); };
        });
      });
    }
    function get(key) { return store('readonly', function (s) { return s.get(key); }).catch(function () {}); }
    // A failed save only costs the resume, never the upload itself.
    function keep(key, value) { return store('readwrite', function (s) { s.put(value, key); }).catch(function () {}); }
    function forget() { return store('readwrite', function (s) { s.clear(); }).catch(function () {}); }

    function sleep(ms) { return new Promise(function (resolve) { setTimeout(resolve, ms); }); }

    // Keep the screen on while photos go up; iOS drops the lock whenever the
    // page hides, so it's taken again on the way back.
    function holdAwake() {
      if (!navigator.wakeLock || wake || document.hidden) return;
      wake = navigator.wakeLock.request('screen').then(function (w) {
        if (!running) w.release();
        w.addEventListener('release', function () { wake = null; });
        return w;
      }).catch(function () { wake = null; });
    }
    function letSleep() {
      if (wake) wake.then(function (w) { if (w) w.release(); });
      wake = null;
    }

    function ready() {
      say(msg, navigator.onLine ? 'paused. picks up when you’re back.' : 'offline. picks up when the signal does.');
      return new Promise(function (resolve) {
        function check() {
          if (document.hidden || !navigator.onLine) return;
          document.removeEventListener('visibilitychange', check);
          removeEventListener('online', check);
          resolve();
        }
        document.addEventListener('visibilitychange', check);
        addEventListener('online', check);
        check();
      });
    }

    // fetch, but patient: dropped connections and 5xx retry with backoff, and a
    // sleeping phone waits to be woken instead of burning its tries.
    async function send(url, init, label) {
      var tries = 0;
      while (true) {
        say(msg, label);
        var ctl = new AbortController();
        var timer = setTimeout(function () { ctl.abort(); }, 60000);
        inflight = ctl;
        revived = false;
        try {
          var r = await fetch(url, Object.assign({ signal: ctl.signal }, init));
          var body = await r.text();
          var out = {};
          try { out = JSON.parse(body); } catch (err) {}
          if (r.ok) return out;
          if (r.status === 401) throw Object.assign(new Error('signed out'), { locked: true });
          if (r.status < 500 && r.status !== 408 && r.status !== 429) throw new Error(out.error || 'that didn’t take');
        } catch (err) {
          if (err.name !== 'TypeError' && err.name !== 'AbortError') throw err;
        } finally {
          clearTimeout(timer);
          inflight = null;
        }
        if (revived) { revived = false; tries = 0; continue; }
        if (document.hidden || !navigator.onLine) { await ready(); tries = 0; continue; }
        if (++tries > 5) throw Object.assign(new Error('stuck'), { stalled: true });
        label = 'signal dropped. trying again…';
        await sleep(1000 * Math.min(Math.pow(2, tries), 16));
      }
    }

    function fields(on) {
      Array.prototype.forEach.call(compose.elements, function (el) {
        if (el !== publishBtn && el !== discardBtn) el.disabled = on;
      });
      picker.parentElement.classList.toggle('off', on);
    }

    function status() {
      publishBtn.disabled = running;
      publishBtn.textContent = job && !running ? 'resume upload' : 'publish';
      discardBtn.hidden = !job || running;
    }

    function mark(i, state) {
      var li = thumbs.children[i];
      if (li) li.dataset.state = state;
    }

    async function run() {
      if (running || !job) return;
      running = true;
      stalled = false;
      status();
      holdAwake();
      try {
        var n = job.photos.length;
        for (var i = 0; i < n; i++) {
          var p = job.photos[i];
          if (p.url) continue;
          if (!files[i] || !files[i].file) throw new Error('lost photo ' + (i + 1) + '. start over?');
          mark(i, 'sending');
          var label = 'uploading ' + (i + 1) + ' of ' + n + '…';
          say(msg, label);
          if (!p.shrunk) {
            var blob = await shrink(files[i].file);
            files[i].file = blob;
            p.shrunk = true;
            await keep('photo-' + i, blob);
            await keep('job', job);
          }
          var up = await send('/api/admin/media?slug=' + job.slug + '&name=' + job.stamp + '-' + (i + 1), {
            method: 'PUT',
            headers: { 'Content-Type': files[i].file.type },
            body: files[i].file,
          }, label);
          if (!up.url) throw new Error('upload failed');
          p.url = up.url;
          mark(i, 'up');
          await keep('job', job);
        }

        var out = await send('/api/admin/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: job.mode,
            slug: job.slug,
            title: job.title,
            tag: job.tag,
            date: job.date,
            draft: job.draft,
            text: job.text,
            images: job.photos.map(function (p) { return p.url; }),
          }),
        }, 'publishing…');

        var isNew = job.mode === 'new';
        var draft = isNew && job.draft;
        if (isNew) { slugs.push(job.slug); f.title.value = ''; }
        f.text.value = '';
        await clear();
        msg.innerHTML = '';
        msg.append(draft ? 'saved as a draft.' : 'done. live in a couple minutes at ');
        if (!draft) {
          var a = document.createElement('a');
          a.href = out.path;
          a.textContent = out.path;
          msg.append(a);
        }
      } catch (err) {
        thumbs.querySelectorAll('[data-state=sending]').forEach(function (li) { li.dataset.state = ''; });
        if (err.locked) {
          compose.hidden = true;
          lock.hidden = false;
          say(lock.querySelector('.msg'), 'signed out. unlock to finish; the photos are saved.');
        } else if (err.stalled) {
          stalled = true;
          say(msg, 'can’t get through. it’ll keep trying, or tap resume.');
        } else {
          say(msg, 'hmm: ' + err.message);
        }
      } finally {
        running = false;
        letSleep();
        status();
      }
    }

    async function clear() {
      job = null;
      files.forEach(function (item) { if (item.preview.startsWith('blob:')) URL.revokeObjectURL(item.preview); });
      files = [];
      await forget();
      fields(false);
      render();
      status();
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { hiddenAt = Date.now(); return; }
      if (running) holdAwake();
      // A request that started before the phone slept is usually dead; restart it.
      if (inflight && Date.now() - hiddenAt > 2000) { revived = true; inflight.abort(); }
      if (stalled) run();
    });
    addEventListener('online', function () { if (stalled) run(); });

    discardBtn.addEventListener('click', function () {
      clear();
      say(msg, '');
    });

    compose.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (job) return run();
      var isNew = f.mode.value === 'new';
      var slug = isNew ? slugify(f.title.value) : f.slug.value;
      var text = f.text.value.trim();
      if (!slug) return say(msg, 'needs a title');
      if (isNew && slugs.indexOf(slug) !== -1) return say(msg, 'there’s already a post called that');
      if (!files.length && !text) return say(msg, 'add some photos or words first');

      job = {
        mode: isNew ? 'new' : 'add',
        slug: slug,
        title: f.title.value,
        tag: f.tag.value,
        date: f.date.value,
        draft: f.draft.checked,
        text: text,
        stamp: Date.now().toString(36),
        photos: files.map(function () { return { url: null, shrunk: false }; }),
      };
      fields(true);
      render();
      status();
      await Promise.all(files.map(function (item, i) { return keep('photo-' + i, item.file); }));
      await keep('job', job);
      run();
    });

    // Back after the tab was dropped: put the form and photos back and carry on.
    Promise.all([authed, get('job')]).then(async function (got) {
      var saved = got[1];
      if (!saved || job) return;
      var blobs = await Promise.all(saved.photos.map(function (p, i) { return get('photo-' + i); }));
      job = saved;
      files = saved.photos.map(function (p, i) {
        return { file: blobs[i], preview: blobs[i] ? URL.createObjectURL(blobs[i]) : p.url || '' };
      });
      f.mode.value = job.mode;
      showMode();
      if (job.mode === 'add') f.slug.value = job.slug;
      f.title.value = job.title;
      f.tag.value = job.tag;
      f.date.value = job.date;
      f.draft.checked = job.draft;
      f.text.value = job.text;
      fields(true);
      render();
      status();
      var done = job.photos.filter(function (p) { return p.url; }).length;
      say(msg, 'picking up where it left off: ' + done + ' of ' + job.photos.length + ' up.');
      if (got[0]) run();
    });
  })();
</script>

<style>
  .admin { color: var(--fg); }
  .back {
    align-self: baseline;
    color: var(--fg-dim);
    font-size: 12px;
  }
  .back:hover { color: var(--accent); }
  h1 {
    font-size: 44px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0;
  }
  form {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .admin [hidden] { display: none; }
  label { display: grid; gap: var(--space-2); }
  .label {
    font-size: 12px;
    color: var(--fg-dim);
  }
  .label em { font-style: normal; opacity: 0.7; }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .for-new { display: grid; gap: var(--space-5); }
  input[type='password'],
  input[type='text'],
  input[type='date'],
  select,
  textarea {
    font: inherit;
    font-size: 16px; /* under 16px and iOS zooms the page on focus */
    color: var(--fg);
    background: var(--tile);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 10px 12px;
    outline: none;
    width: 100%;
    min-width: 0;
    -webkit-appearance: none;
    appearance: none;
  }
  textarea { resize: vertical; line-height: 1.5; }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); }

  .modes {
    display: flex;
    gap: var(--space-2);
  }
  .modes label, .check { display: flex; align-items: center; gap: var(--space-2); }
  .modes input { position: absolute; opacity: 0; pointer-events: none; }
  .modes span {
    padding: 8px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 14px;
    color: var(--fg-dim);
  }
  .modes input:checked + span {
    color: var(--fg);
    border-color: var(--fg);
  }
  .modes input:focus-visible + span { border-color: var(--accent); }
  .check { font-size: 14px; color: var(--fg-dim); }
  .check input { accent-color: var(--accent); width: 18px; height: 18px; }

  .pick input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pick span {
    display: block;
    padding: 28px 16px;
    border: 1px dashed var(--fg-dim);
    border-radius: 6px;
    text-align: center;
    font-size: 15px;
    color: var(--fg);
  }
  .pick input:focus-visible + span { border-color: var(--accent); }

  .thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: var(--space-2);
  }
  .thumbs:empty { display: none; }
  /* Thumbnails are built in JS, so they miss Astro's scoping attribute. */
  .thumbs :global(li) { position: relative; aspect-ratio: 1; }
  .thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px;
    display: block;
  }
  .thumbs :global(button) {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 16px;
    line-height: 1;
  }

  .thumbs :global(li[data-state] img) { opacity: 0.4; transition: opacity 0.3s; }
  .thumbs :global(li[data-state='sending'] img) { animation: pulse 1.2s ease-in-out infinite alternate; }
  .thumbs :global(li[data-state='up'] img) { opacity: 1; }
  .thumbs :global(li[data-state='up'])::after {
    content: '✓';
    position: absolute;
    left: 4px;
    bottom: 4px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 13px;
    line-height: 22px;
    text-align: center;
  }
  @keyframes pulse { to { opacity: 0.85; } }
  .pick.off span { opacity: 0.4; }

  button[type='submit'] {
    justify-self: start;
    padding: 10px 20px;
    border: 1px solid var(--fg-dim);
    border-radius: 999px;
    color: var(--fg);
    font-size: 15px;
  }
  button[type='submit']:hover { color: var(--accent); border-color: var(--accent); }
  button[type='submit']:disabled { opacity: 0.5; }
  button.publish { justify-self: stretch; }
  .discard {
