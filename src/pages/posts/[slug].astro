---
export const prerender = true;
import { getCollection } from 'astro:content';
import PostLayout, { type SpecRow } from '../../layouts/PostLayout.astro';
import { renderPostHtml } from '../../lib/posts';
import { groupImagesIntoGrid, stripMetaParagraphs, addFigCaptions, isExcerptRedundant } from '../../lib/imageGrid';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (e) => !e.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
// Hero (rendered below) is FIG. 01; body figure numbering continues after it.
const html = addFigCaptions(
  groupImagesIntoGrid(stripMetaParagraphs(await renderPostHtml(entry))),
  entry.data.title,
  entry.data.feature_image ? 2 : 1
);

// Imported posts often reuse the first body paragraph as the excerpt —
// skip the lede then so the text doesn't render twice.
const showLede = !!entry.data.excerpt && !isExcerptRedundant(html, entry.data.excerpt);

const dateLabel = entry.data.dateLabel ?? entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isWork = entry.data.tags.includes('work') || entry.data.tags.includes('archive') || entry.data.tags.includes('projects');
// Dates/years keep the mono spec voice; wordy rows (discipline, roles,
// tools) read in the body font like every other label on the site.
const specRows: SpecRow[] = isWork
  ? [
      { value: entry.data.dateLabel ?? String(entry.data.date.getFullYear()), mono: true },
      ...(entry.data.discipline || entry.data.category ? [{ value: (entry.data.discipline ?? entry.data.category)!, accent: true }] : []),
      ...(entry.data.roles ? [{ value: entry.data.roles }] : []),
      ...(entry.data.tools ? [{ value: entry.data.tools }] : []),
    ]
  : [{ value: dateLabel, mono: true }];
---
<PostLayout
  title={entry.data.title}
  description={entry.data.excerpt}
  spec={specRows}
  lede={showLede ? entry.data.excerpt : undefined}
  hero={entry.data.feature_image}
>
  <Fragment set:html={html} />
</PostLayout>
