---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ProjectFrame from '../layouts/ProjectFrame.astro';
import GridbitTool from '../components/GridbitTool.tsx';
import AppearanceChrome from '../components/AppearanceChrome.tsx';
---
<Layout title="gridbit — hudbud.net" description="Turn pixel art into a crochet or knitting chart — numbered rows and stitches, minor and major grid lines, exportable as a big PNG, JPEG, or SVG.">
  <ProjectFrame fill>
    <GridbitTool client:only="react" />
  </ProjectFrame>
  <AppearanceChrome client:load />
</Layout>
