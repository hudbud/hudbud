---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ProjectFrame from '../layouts/ProjectFrame.astro';
import { KEYBOARD_HTML } from '../data/keyboard';
---
<Layout
  title="A Better Mechanical Keyboard — Hudson Paine"
  description="Senior project, 2019. A quieter, split mechanical keyboard."
>
  <ProjectFrame>
    <article class="writeup">
      <header>
        <p class="meta">project · senior project, 2019</p>
        <h1>A Better Mechanical Keyboard</h1>
      </header>
      <div set:html={KEYBOARD_HTML} />
    </article>
  </ProjectFrame>
</Layout>

<style>
  .writeup {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px 120px;
    color: var(--fg);
  }
  .meta {
    color: var(--fg-faint);
    font-size: 11px;
    margin: 0 0 8px;
  }
  h1 {
    font-size: 32px;
    line-height: 1.2;
    color: var(--accent);
    letter-spacing: -0.005em;
    font-weight: 500;
    margin: 0 0 28px;
  }
  .writeup :global(p),
  .writeup :global(ul),
  .writeup :global(ol) {
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 1em;
  }
  .writeup :global(h2),
  .writeup :global(h3) {
    color: var(--fg);
    margin: 1.6em 0 0.6em;
  }
  .writeup :global(a) {
    color: var(--accent);
  }
</style>
