---
export const prerender = true;
import PostLayout from '../layouts/PostLayout.astro';
import { KEYBOARD_HTML } from '../data/keyboard';

// The write-up opens on the hero shot; lift it into the hero slot.
const HERO = '/images/keyboard/image20.jpg';
const body = KEYBOARD_HTML.replace(`<figure class="kb-fig"><img src="${HERO}" alt="Better Mechanical Keyboard" /></figure>`, '');
---
<PostLayout
  title="A Better Mechanical Keyboard"
  pageTitle="A Better Mechanical Keyboard — Hudson Paine"
  description="Senior project, 2019. A quieter, split mechanical keyboard."
  spec={[{ value: '2019', mono: true }, { value: 'product design, hardware', accent: true }, { value: 'senior project' }]}
  hero={HERO}
>
  <Fragment set:html={body} />
</PostLayout>
